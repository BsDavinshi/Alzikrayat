# Uploaded files are data, never code: disable every script handler here.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .pl .py .cgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar

<FilesMatch "\.(?i:php|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
